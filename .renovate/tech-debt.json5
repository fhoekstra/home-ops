{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      description: "Stick to Grafana 12 as that is the operator default for now",
      matchDatasources: ["docker"],
      matchPackageNames: ["/grafana/grafana/"],
      allowedVersions: "<13",
    },
  ],
}
